# AI gateway configuration (server-side only — never exposed to the browser).
# Copy this file to `.env.local` and fill in your provider + key.
#
# The gateway speaks the OpenAI-compatible /chat/completions API, so any of
# these providers work. Switch provider by changing AI_PROVIDER (and the key).
# Without configuration, AI-powered features (generate list, audit) are
# unavailable, but offline features (quick-add parsing, auto-categorize) still
# work with no key.

# Which provider to use: gemini | mistral | openai | deepseek | ollama
AI_PROVIDER=gemini

# Model id. Leave blank to use the provider's default
# (gemini-3.5-flash-lite | mistral-small-2603 | gpt-4o-mini | deepseek-chat | llama3.1).
# Gemini 3.5 Flash-Lite is current, stable, and suited to Luggist's small
# structured-output tasks. Mistral remains available as an opt-in.
AI_MODEL=gemini-3.5-flash-lite

# Override the API base URL only when using a custom compatible gateway.
# Leave blank for Gemini; its Google endpoint is built in. If this contains a
# known URL from a different provider, Luggist ignores it to prevent sending a
# provider key to the wrong service.
#
# Provider defaults:
#   gemini   -> https://generativelanguage.googleapis.com/v1beta/openai/
#   mistral  -> https://api.mistral.ai/v1
#   openai   -> https://api.openai.com/v1
#   deepseek -> https://api.deepseek.com/v1
#   ollama   -> http://localhost:11434/v1
AI_BASE_URL=

# API key for the chosen cloud provider. Not needed for local Ollama.
AI_API_KEY=
